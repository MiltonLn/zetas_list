generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  admin
  ayudante
  member
}

enum UserStatus {
  active
  inactive
  banned
}

enum Position {
  auxiliar
  libero
  armador
  central
  opuesto
}

enum Gender {
  masculino
  femenino
  otro
}

enum ShirtSize {
  XS
  S
  M
  L
  XL
  XXL
}

enum OrderStatus {
  pending
  deposit_paid
  paid
  delivered
  cancelled
}

enum Modalidad {
  seis_x_seis
  cuatro_x_cuatro
}

enum GameStatus {
  scheduled
  registration_open
  in_progress
  completed
  cancelled
}

enum AuditAction {
  player_registered
  player_removed
  player_promoted
  player_demoted
  player_reordered
  attendance_toggled
  payment_toggled
  note_updated
  game_created
  game_updated
  game_cancelled
  game_completed
  game_status_changed
  user_created
  user_updated
  user_status_changed
  fine_exemption_toggled
  guest_registered
  proxy_registered
  confirmation_requested
  confirmation_received
  confirmation_expired
  order_created
  order_updated
  order_status_changed
  tournament_created
  tournament_updated
  tournament_status_changed
  tournament_team_registered
  tournament_team_removed
  tournament_match_updated
}

enum TournamentStatus {
  draft
  registration_open
  in_progress
  completed
  cancelled
}

enum TournamentFormat {
  groups_and_knockout
  league_and_knockout
  knockout_only
}

enum MatchStatus {
  scheduled
  in_progress
  completed
  cancelled
}

enum TransactionType {
  income
  expense
}

enum FineStatus {
  pending
  paid
}

model User {
  id           String     @id @default(uuid())
  username     String     @unique
  passwordHash String
  name         String
  alias        String?
  phone        String     @unique
  whatsappLid  String?    @unique
  role         Role       @default(member)
  position     Position?
  gender       Gender?
  heightCm     Int?
  birthDate    DateTime?
  photoUrl     String?
  bio          String?
  shirtSize    ShirtSize?
  shirtNumber  Int?
  mustChangePassword Boolean @default(true)
  status       UserStatus @default(active)
  banReason    String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  createdGames  Game[]             @relation("CreatedBy")
  registrations GameRegistration[] @relation("RegisteredUser")
  registeredBy  GameRegistration[] @relation("RegisteredBy")
  auditLogs     AuditLog[]         @relation("AuditActor")
  targetLogs    AuditLog[]         @relation("AuditTarget")
  fines              Fine[]               @relation("FinedUser")
  createdFines       Fine[]               @relation("FineCreator")
  transactions       FinanceTransaction[] @relation("TransactionCreator")
  orders             Order[]              @relation("OrderUser")
  createdTournaments Tournament[]         @relation("TournamentCreatedBy")
  tournamentTeams    TournamentTeam[]     @relation("TeamRegisteredBy")
  tournamentPlayers  TournamentPlayer[]   @relation("PlayerUser")

  @@map("users")
}

model Game {
  id                    String     @id @default(uuid())
  title                 String
  modalidad             Modalidad
  gameDate              DateTime   @db.Date
  startTime             String     @default("19:50")
  registrationOpenAt    DateTime
  maxMainSpots          Int
  pricePerPlayer        Int        @default(2000)
  vigilante             Int        @default(10000)
  status                GameStatus @default(scheduled)
  cancellationReason    String?
  completionReport      String?
  guestCutoffTime       String     @default("13:30")
  maxProxyRegistrations Int        @default(1)
  mainListHasBeenFull   Boolean    @default(false)
  cutoffNotified        Boolean    @default(false)
  fineAmountNoShow      Int        @default(5000)
  createdById           String
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt

  createdBy     User               @relation("CreatedBy", fields: [createdById], references: [id])
  registrations GameRegistration[]
  auditLogs     AuditLog[]
  transactions  FinanceTransaction[]
  fines         Fine[]

  @@map("games")
  @@index([status, registrationOpenAt])
  @@index([gameDate, status])
}

model GameRegistration {
  id                   String    @id @default(uuid())
  gameId               String
  userId               String?
  position             Int
  isWaitingList        Boolean   @default(false)
  attended             Boolean   @default(false)
  paid                 Boolean   @default(false)
  note                 String?
  fromWaitList         Boolean   @default(false)
  fineExempt           Boolean   @default(false)
  isGuest              Boolean   @default(false)
  guestName            String?
  pendingConfirmation  Boolean   @default(false)
  confirmationDeadline DateTime?
  confirmationDeclined Boolean   @default(false)
  originalWaitPosition Int?
  registeredAt         DateTime  @default(now())
  registeredById       String

  game         Game  @relation(fields: [gameId], references: [id], onDelete: Cascade)
  user         User? @relation("RegisteredUser", fields: [userId], references: [id])
  registeredBy User  @relation("RegisteredBy", fields: [registeredById], references: [id])

  @@unique([gameId, userId])
  @@map("game_registrations")
  @@index([gameId, isWaitingList, position])
  @@index([pendingConfirmation, confirmationDeadline])
}

model AuditLog {
  id           String      @id @default(uuid())
  gameId       String?
  actorId      String?
  targetUserId String?
  action       AuditAction
  details      Json        @default("{}")
  createdAt    DateTime    @default(now())

  game       Game? @relation(fields: [gameId], references: [id], onDelete: SetNull)
  actor      User? @relation("AuditActor", fields: [actorId], references: [id])
  targetUser User? @relation("AuditTarget", fields: [targetUserId], references: [id])

  @@map("audit_logs")
  @@index([gameId, createdAt])
}

model WhatsappSession {
  key   String @id
  value String @db.Text

  @@map("whatsapp_sessions")
}

model FinanceTransaction {
  id          String          @id @default(uuid())
  type        TransactionType
  date        DateTime        @db.Date
  amount      Int
  description String
  gameId      String?
  createdById String
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  game      Game? @relation(fields: [gameId], references: [id], onDelete: SetNull)
  createdBy User  @relation("TransactionCreator", fields: [createdById], references: [id])

  @@map("finance_transactions")
  @@index([type, date])
}

model Fine {
  id                 String     @id @default(uuid())
  userId             String?
  userName           String?
  date               DateTime   @db.Date
  amount             Int
  reason             String
  status             FineStatus @default(pending)
  paidAt             DateTime?
  gameId             String?
  gameRegistrationId String?
  createdById        String
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  user      User?  @relation("FinedUser", fields: [userId], references: [id])
  game      Game? @relation(fields: [gameId], references: [id], onDelete: SetNull)
  createdBy User  @relation("FineCreator", fields: [createdById], references: [id])

  @@map("fines")
  @@index([userId, status])
  @@index([date])
}

model Order {
  id          String      @id @default(uuid())
  userId      String
  status      OrderStatus @default(pending)
  totalAmount Int
  notes       String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  user  User        @relation("OrderUser", fields: [userId], references: [id])
  items OrderItem[]

  @@map("orders")
  @@index([status, createdAt])
  @@index([userId, createdAt])
}

model OrderItem {
  id           String     @id @default(uuid())
  orderId      String
  productId    String
  productName  String
  variantId    String
  variantName  String
  size         ShirtSize?
  quantity     Int
  customName   String?
  customNumber Int?
  unitPrice    Int
  lineTotal    Int

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("order_items")
  @@index([orderId])
}

model Tournament {
  id                 String           @id @default(uuid())
  name               String
  format             TournamentFormat
  modalidad          Modalidad
  status             TournamentStatus @default(draft)
  registrationOpenAt DateTime
  startDate          DateTime
  endDate            DateTime
  pricePerTeam       Int              @default(0)
  prizeDescription   String?
  maxTeams           Int
  minPlayersPerTeam  Int              @default(4)
  maxPlayersPerTeam  Int              @default(8)
  minZetasMembers    Int              @default(0)
  allowExternalTeams Boolean          @default(true)
  numberOfGroups     Int?
  competitionRules   Json             @default("{\"version\":1,\"groupStage\":{\"matchFormat\":\"best_of_three\",\"qualifiersPerGroup\":2,\"standingsPoints\":{\"straightWin\":3,\"splitWin\":2,\"splitLoss\":1,\"straightLoss\":0},\"tiebreakers\":[\"wins\",\"setDifference\",\"pointDifference\",\"headToHead\"],\"regularSetPoints\":25,\"tiebreakSetPoints\":15},\"knockoutStage\":{\"matchFormat\":\"best_of_three\",\"regularSetPoints\":25,\"tiebreakSetPoints\":15,\"includeThirdPlace\":true,\"pairingStrategy\":\"cross_group\"}}")
  rules              String?
  rulesFileUrl       String?
  flyerUrl           String?
  createdById        String
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  createdBy User             @relation("TournamentCreatedBy", fields: [createdById], references: [id])
  teams     TournamentTeam[]
  matches   TournamentMatch[]

  @@map("tournaments")
  @@index([status, startDate])
}

model TournamentTeam {
  id             String     @id @default(uuid())
  tournamentId   String
  name           String
  paid           Boolean    @default(false)
  seed           Int?
  groupLabel     String?
  registeredById String
  createdAt      DateTime   @default(now())

  tournament   Tournament         @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  registeredBy User               @relation("TeamRegisteredBy", fields: [registeredById], references: [id])
  players      TournamentPlayer[]
  matchesAsA   TournamentMatch[]  @relation("MatchTeamA")
  matchesAsB   TournamentMatch[]  @relation("MatchTeamB")
  wonMatches   TournamentMatch[]  @relation("MatchWinner")

  @@map("tournament_teams")
  @@index([tournamentId])
}

model TournamentPlayer {
  id         String  @id @default(uuid())
  teamId     String
  userId     String?
  guestName  String?
  isCaptain  Boolean @default(false)

  team TournamentTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User?         @relation("PlayerUser", fields: [userId], references: [id])

  @@map("tournament_players")
  @@index([teamId])
}

model TournamentMatch {
  id           String      @id @default(uuid())
  tournamentId String
  phase        String
  groupLabel   String?
  roundNumber  Int
  matchOrder   Int
  teamAId      String?
  teamBId      String?
  winnerId     String?
  status       MatchStatus @default(scheduled)
  scheduledAt  DateTime?
  court        String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  tournament Tournament      @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  teamA      TournamentTeam? @relation("MatchTeamA", fields: [teamAId], references: [id])
  teamB      TournamentTeam? @relation("MatchTeamB", fields: [teamBId], references: [id])
  winner     TournamentTeam? @relation("MatchWinner", fields: [winnerId], references: [id])
  sets       TournamentSet[]

  @@map("tournament_matches")
  @@index([tournamentId, phase])
}

model TournamentSet {
  id       String @id @default(uuid())
  matchId  String
  setNumber Int
  scoreA   Int
  scoreB   Int

  match TournamentMatch @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@unique([matchId, setNumber])
  @@map("tournament_sets")
}
