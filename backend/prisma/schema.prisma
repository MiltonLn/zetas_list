generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  admin
  member
}

enum UserStatus {
  active
  inactive
  banned
}

enum Position {
  auxiliar
  libero
  armador
  central
  opuesto
}

enum Gender {
  masculino
  femenino
  otro
}

enum Modalidad {
  seis_x_seis
  cuatro_x_cuatro
  torneo
}

enum GameStatus {
  scheduled
  registration_open
  in_progress
  completed
  cancelled
}

enum AuditAction {
  player_registered
  player_removed
  player_promoted
  player_demoted
  player_reordered
  attendance_toggled
  payment_toggled
  note_updated
  game_created
  game_updated
  game_cancelled
  game_completed
  game_status_changed
  user_created
  user_updated
  user_status_changed
  fine_exemption_toggled
  guest_registered
  proxy_registered
  confirmation_requested
  confirmation_received
  confirmation_expired
}

enum TransactionType {
  income
  expense
}

enum FineStatus {
  pending
  paid
}

model User {
  id           String     @id @default(uuid())
  username     String     @unique
  passwordHash String
  name         String
  phone        String     @unique
  whatsappLid  String?    @unique
  role         Role       @default(member)
  position     Position?
  gender       Gender?
  heightCm     Int?
  birthDate    DateTime?
  photoUrl     String?
  bio          String?
  mustChangePassword Boolean @default(true)
  status       UserStatus @default(active)
  banReason    String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  createdGames  Game[]             @relation("CreatedBy")
  registrations GameRegistration[] @relation("RegisteredUser")
  registeredBy  GameRegistration[] @relation("RegisteredBy")
  auditLogs     AuditLog[]         @relation("AuditActor")
  targetLogs    AuditLog[]         @relation("AuditTarget")
  fines              Fine[]               @relation("FinedUser")
  createdFines       Fine[]               @relation("FineCreator")
  transactions       FinanceTransaction[] @relation("TransactionCreator")

  @@map("users")
}

model Game {
  id                    String     @id @default(uuid())
  title                 String
  modalidad             Modalidad
  gameDate              DateTime   @db.Date
  startTime             String     @default("19:50")
  registrationOpenAt    DateTime
  maxMainSpots          Int
  pricePerPlayer        Int        @default(2000)
  vigilante             Int        @default(10000)
  status                GameStatus @default(scheduled)
  cancellationReason    String?
  completionReport      String?
  guestCutoffTime       String     @default("13:30")
  maxProxyRegistrations Int        @default(1)
  mainListHasBeenFull   Boolean    @default(false)
  cutoffNotified        Boolean    @default(false)
  fineAmountNoShow      Int        @default(5000)
  createdById           String
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt

  createdBy     User               @relation("CreatedBy", fields: [createdById], references: [id])
  registrations GameRegistration[]
  auditLogs     AuditLog[]
  transactions  FinanceTransaction[]
  fines         Fine[]

  @@map("games")
  @@index([status, registrationOpenAt])
  @@index([gameDate, status])
}

model GameRegistration {
  id                   String    @id @default(uuid())
  gameId               String
  userId               String?
  position             Int
  isWaitingList        Boolean   @default(false)
  attended             Boolean   @default(false)
  paid                 Boolean   @default(false)
  note                 String?
  fromWaitList         Boolean   @default(false)
  fineExempt           Boolean   @default(false)
  isGuest              Boolean   @default(false)
  guestName            String?
  pendingConfirmation  Boolean   @default(false)
  confirmationDeadline DateTime?
  confirmationDeclined Boolean   @default(false)
  originalWaitPosition Int?
  registeredAt         DateTime  @default(now())
  registeredById       String

  game         Game  @relation(fields: [gameId], references: [id], onDelete: Cascade)
  user         User? @relation("RegisteredUser", fields: [userId], references: [id])
  registeredBy User  @relation("RegisteredBy", fields: [registeredById], references: [id])

  @@unique([gameId, userId])
  @@map("game_registrations")
  @@index([gameId, isWaitingList, position])
  @@index([pendingConfirmation, confirmationDeadline])
}

model AuditLog {
  id           String      @id @default(uuid())
  gameId       String?
  actorId      String?
  targetUserId String?
  action       AuditAction
  details      Json        @default("{}")
  createdAt    DateTime    @default(now())

  game       Game? @relation(fields: [gameId], references: [id], onDelete: SetNull)
  actor      User? @relation("AuditActor", fields: [actorId], references: [id])
  targetUser User? @relation("AuditTarget", fields: [targetUserId], references: [id])

  @@map("audit_logs")
  @@index([gameId, createdAt])
}

model WhatsappSession {
  key   String @id
  value String @db.Text

  @@map("whatsapp_sessions")
}

model FinanceTransaction {
  id          String          @id @default(uuid())
  type        TransactionType
  date        DateTime        @db.Date
  amount      Int
  description String
  gameId      String?
  createdById String
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  game      Game? @relation(fields: [gameId], references: [id], onDelete: SetNull)
  createdBy User  @relation("TransactionCreator", fields: [createdById], references: [id])

  @@map("finance_transactions")
  @@index([type, date])
}

model Fine {
  id                 String     @id @default(uuid())
  userId             String
  date               DateTime   @db.Date
  amount             Int
  reason             String
  status             FineStatus @default(pending)
  paidAt             DateTime?
  gameId             String?
  gameRegistrationId String?
  createdById        String
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  user      User  @relation("FinedUser", fields: [userId], references: [id])
  game      Game? @relation(fields: [gameId], references: [id], onDelete: SetNull)
  createdBy User  @relation("FineCreator", fields: [createdById], references: [id])

  @@map("fines")
  @@index([userId, status])
  @@index([date])
}
