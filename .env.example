# === DATABASE ===
DATABASE_URL=postgresql://zetas:change_this_password@db:5432/zetas
DB_PASSWORD=change_this_password

# === JWT ===
# Obligatoria en todos los entornos. Mínimo 16 caracteres: el backend no
# arranca si falta o es demasiado corta (no hay valor por defecto).
JWT_SECRET=change_this_to_a_long_random_secret

# === APP ===
# NODE_ENV: development | test | production
NODE_ENV=development
PORT=3000
# URL pública del frontend, usada en los links que envía el bot de WhatsApp
APP_URL=http://localhost:5173
# Origen permitido por CORS en el backend
FRONTEND_URL=http://localhost:5173
# Nivel de log del backend: fatal | error | warn | info | debug | trace | silent
# Por defecto: info en producción, debug en desarrollo
LOG_LEVEL=

# === FRONTEND ===
VITE_API_URL=http://localhost:3000/api
VITE_SENTRY_DSN=

# === WHATSAPP ===
# 'cli' for development simulator, 'baileys' for production
WHATSAPP_MODE=cli
WHATSAPP_GROUP_ID=
# Nivel de log de las tripas de Baileys. Subir a 'debug' solo para depurar
# la conexión de WhatsApp.
WA_LOG_LEVEL=warn
# Bre-B key shown when users ask for payment info (@Z llave / pagos)
BREB_KEY=@MLR608

# === SENTRY ===
# DSN del proyecto en https://sentry.io → Settings → Projects → <proyecto> → Client Keys
# Dejar vacío en desarrollo para deshabilitar Sentry sin errores.
SENTRY_DSN=
# DSN del proyecto frontend (puede ser el mismo proyecto o uno separado)
# VITE_SENTRY_DSN ya está arriba en la sección FRONTEND
