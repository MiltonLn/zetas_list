#!/bin/sh
# Pre-commit: lint whichever sub-project has staged changes.
# One-time setup: run `make hooks` (or `git config core.hooksPath .husky`).

set -e

CYAN='\033[0;36m'
GREEN='\033[0;32m'
RED='\033[0;31m'
RESET='\033[0m'

FRONTEND_STAGED=$(git diff --cached --name-only --diff-filter=ACMR | grep "^frontend/src/.*\.\(ts\|tsx\)$" || true)
BACKEND_STAGED=$(git diff --cached --name-only --diff-filter=ACMR | grep "^backend/src/.*\.ts$" || true)

if [ -z "$FRONTEND_STAGED" ] && [ -z "$BACKEND_STAGED" ]; then
  exit 0
fi

if [ -n "$FRONTEND_STAGED" ]; then
  printf "${CYAN}→ Frontend lint...${RESET}\n"
  if ! (cd frontend && npm run lint -- --max-warnings=0 2>&1); then
    printf "${RED}✗ Frontend lint failed. Fix errors above before committing.${RESET}\n"
    exit 1
  fi
fi

if [ -n "$BACKEND_STAGED" ]; then
  printf "${CYAN}→ Backend lint...${RESET}\n"
  if ! (cd backend && npm run lint -- --max-warnings=0 2>&1); then
    printf "${RED}✗ Backend lint failed. Fix errors above before committing.${RESET}\n"
    exit 1
  fi
fi

printf "${GREEN}✓ Pre-commit checks passed${RESET}\n"
